# Model Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=hf.co/nbpedro315/Dolphin3-Cyber-8B-GGUF:Q4_K_M
OBSERVER_MODEL=hf.co/nbpedro315/Dolphin3-Cyber-8B-GGUF:Q4_K_M
MEMORY_MODEL=hf.co/nbpedro315/Dolphin3-Cyber-8B-GGUF:Q4_K_M

# Conversation Settings
MAX_TURNS=1000
TURN_TIMEOUT_SECONDS=120
CONTEXT_WINDOW=4096
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.7

# Memory Settings
SHORT_TERM_TURNS=8
SUMMARIZATION_INTERVAL=10
MAX_MEMORY_ENTRIES=1000

# Resource Management
MEMORY_WARNING_THRESHOLD_GB=12
MEMORY_CRITICAL_THRESHOLD_GB=14
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95
GENERATION_LATENCY_WARNING_MS=5000

# Audio Settings
TTS_ENABLED=false
STT_ENABLED=false
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
STT_MODEL=base

# Permissions
PERMISSION_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Paths
DATA_DIR=./data
LOGS_DIR=./logs
CONFIG_DIR=./config